# PostgreSQL connection string. Use a persistent, backed-up database in production.
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>

# Exact comma-separated origins. Replace localhost values for production.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

# Generate separate, high-entropy secrets in production. Never commit real values.
JWT_SECRET=<generate-a-long-random-jwt-secret>
COOKIE_SECRET=<generate-a-long-random-cookie-secret>

# Production must use persistent Redis; do not rely on Medusa's in-memory fallback.
REDIS_URL=redis://<user>:<password>@<host>:6379

# Manual bank-transfer details. Configure through deployment secrets/environment only.
MANUAL_PAYMENT_CARD_NUMBER=<configured-by-business>
MANUAL_PAYMENT_ACCOUNT_HOLDER=<configured-by-business>
MANUAL_PAYMENT_BANK_NAME=<configured-by-business-or-empty>
MANUAL_PAYMENT_INSTRUCTIONS_FA=<configured-by-business-or-empty>
MANUAL_PAYMENT_INSTRUCTIONS_EN=<configured-by-business-or-empty>

# Provider boundary:
# - Medusa's local File provider is development-only for this project.
# - Production receipt uploads require durable private object storage.
# - A transactional email provider is not configured.
# - SMS is not currently required by implemented flows.
